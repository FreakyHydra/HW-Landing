PORT=8787
NODE_ENV=development

# Shared Discord SSO authority. Production defaults are the live Howling Whispers domains,
# but define these explicitly on the server for clarity.
CODA_AUTH_BASE_URL=https://admin.thehowlingwhispers.com
PUBLIC_BASE_URL=https://thehowlingwhispers.com
CODA_COOKIE_DOMAIN=.thehowlingwhispers.com

# Where unauthenticated lobby visitors are sent.
VITE_AUTH_URL=/

# Authenticated destination targets exposed by the lobby.
VITE_HW_APP_URL=/hwrpv2/
VITE_SANDBOX_URL=https://sandbox.thehowlingwhispers.com
VITE_EVE_CORP_URL=/eve/lightyear-apart/

# Role IDs are evaluated by HW Landing after Coda confirms the signed-in guild member.
# Stable access is granted to every authenticated guild member.
# Alpha automatically inherits Beta access. Developer unlocks every project.
DISCORD_BETA_ROLE_IDS=
DISCORD_ALPHA_ROLE_IDS=
DISCORD_DEV_ROLE_IDS=

# Backward-compatible alias. Values here are treated as Closed Beta access.
DISCORD_EA_ROLE_IDS=