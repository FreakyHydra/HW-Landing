PORT=8787
NODE_ENV=development

# Optional server-side NovelAI Persistent API token for the world runtime.
# If omitted, a user can set a browser-session-only token with /nai token <token> after entering a world.
NOVELAI_API_TOKEN=

# Support intake AI triage.
# Primary: OpenAI Responses API using a Codex-capable model.
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-5.3-codex

# Fallback: Kilo in Auto Free mode. Keep these server-side only.
# KILO_API_BASE_URL should point to the OpenAI-compatible Kilo API base used by the deployment.
KILO_API_TOKEN=
KILO_API_BASE_URL=
KILO_API_PATH=/v1/chat/completions
KILO_SUPPORT_MODEL=auto-free

# GitHub synchronization for canonical support items.
# Use a narrowly scoped token that can create/update issues in this repository.
GITHUB_SUPPORT_TOKEN=
GITHUB_SUPPORT_REPO=FreakyHydra/HW-Landing

# Optional persistent support archive location. Defaults to .support-data in the app root.
SUPPORT_DATA_DIR=

# Shared Discord SSO authority. Production defaults are the live Howling Whispers domains,
# but define these explicitly on the server for clarity.
CODA_AUTH_BASE_URL=https://admin.thehowlingwhispers.com
PUBLIC_BASE_URL=https://thehowlingwhispers.com
CODA_COOKIE_DOMAIN=.thehowlingwhispers.com

# Role IDs are evaluated by HW Landing after Coda confirms the signed-in guild member.
# Stable access is granted to every authenticated guild member.
# Alpha automatically inherits Beta access. Developer unlocks every project.
DISCORD_BETA_ROLE_IDS=
DISCORD_ALPHA_ROLE_IDS=
DISCORD_DEV_ROLE_IDS=

# Backward-compatible alias. Values here are treated as Closed Beta access.
DISCORD_EA_ROLE_IDS=
