PORT=8787
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/auth/discord/callback
DISCORD_GUILD_ID=

# Set true if only members of DISCORD_GUILD_ID should pass the gate.
REQUIRE_GUILD_MEMBERSHIP=false

# Comma-separated Discord role IDs.
# Stable access is granted after successful Discord authentication.
# Alpha automatically inherits Beta access. Developer unlocks every project.
DISCORD_BETA_ROLE_IDS=
DISCORD_ALPHA_ROLE_IDS=
DISCORD_DEV_ROLE_IDS=

# Backward-compatible alias. Values here are treated as Closed Beta access.
DISCORD_EA_ROLE_IDS=
